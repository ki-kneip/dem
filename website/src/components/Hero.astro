---
const repo = "https://github.com/ki-kneip/dem";
---

<header class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-overlay"></div>
    <div class="glow glow-a"></div>
    <div class="glow glow-b"></div>
  </div>

  <nav class="container nav">
    <a href="#top" class="brand">
      <span class="brand-mark">$</span> dem
    </a>
    <div class="nav-links">
      <a href="#why">Why</a>
      <a href="#install">Install</a>
      <a href="#commands">Commands</a>
      <a href="#how">How it works</a>
      <a
        class="version-badge"
        href={`${repo}/releases/latest`}
        target="_blank"
        rel="noopener"
      >
        <span class="version-dot" aria-hidden="true"></span>
        <span id="version-text">Latest release</span>
      </a>
      <a href={repo} target="_blank" rel="noopener" class="nav-gh">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        GitHub
      </a>
    </div>
  </nav>

  <div class="container hero-inner" id="top">
    <div class="hero-copy">
      <p class="hero-eyebrow reveal">
        <span class="pulse-dot"></span>
        Go · Node.js · pnpm — more to come
      </p>
      <h1 class="hero-title reveal" style="--reveal-delay: 80ms">
        One version manager<br />
        for <span class="grad">all your runtimes</span>
      </h1>
      <p class="hero-sub reveal" style="--reveal-delay: 160ms">
        A single binary that installs and manages versions of your runtimes,
        SDKs and CLIs — per project or globally. No shell hacks, no config
        sprawl, and first-class Windows support.
      </p>
      <div class="hero-actions reveal" style="--reveal-delay: 240ms">
        <a class="btn btn-primary" href={`${repo}/releases/latest`} target="_blank" rel="noopener">
          Download
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </a>
        <a class="btn btn-ghost" href={repo} target="_blank" rel="noopener">View on GitHub</a>
      </div>
      <div class="hero-meta reveal" style="--reveal-delay: 320ms">
        <span>Windows</span><i></i><span>Linux</span><i></i><span>macOS</span><i></i><span>MIT</span>
      </div>
    </div>

    <div class="terminal-wrap reveal" style="--reveal-delay: 200ms">
      <div class="terminal">
        <div class="terminal-bar">
          <span class="dot dot-r"></span>
          <span class="dot dot-y"></span>
          <span class="dot dot-g"></span>
          <span class="terminal-title">~/my-project</span>
        </div>
        <div class="terminal-body" id="term" aria-label="dem demo terminal"></div>
      </div>
      <div class="terminal-shadow" aria-hidden="true"></div>
    </div>
  </div>
</header>

<script>
  const lines = [
    { type: "cmd", text: "dem install node@lts" },
    { type: "ok", text: "node@24.18.0 installed" },
    { type: "cmd", text: "dem use node@24 --global" },
    { type: "ok", text: "node@24.18.0 set as the global default" },
    { type: "cmd", text: "node --version" },
    { type: "out", text: "v24.18.0" },
  ];

  const term = document.getElementById("term")!;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function makeLine(type: string) {
    const line = document.createElement("div");
    line.className = `t-line t-${type}`;
    if (type === "cmd") {
      const p = document.createElement("span");
      p.className = "t-prompt";
      p.textContent = "$ ";
      line.appendChild(p);
    } else if (type === "ok") {
      const c = document.createElement("span");
      c.className = "t-check";
      c.textContent = "✓ ";
      line.appendChild(c);
    }
    const body = document.createElement("span");
    line.appendChild(body);
    term.appendChild(line);
    return body;
  }

  function cursorTo(el: Element | null) {
    document.querySelector(".t-cursor")?.remove();
    if (!el) return;
    const c = document.createElement("span");
    c.className = "t-cursor";
    el.appendChild(c);
  }

  async function type(el: HTMLElement, text: string) {
    for (const ch of text) {
      el.textContent += ch;
      await wait(28 + Math.random() * 42);
    }
  }

  async function play() {
    if (reduced) {
      for (const l of lines) makeLine(l.type).textContent = l.text;
      return;
    }
    await wait(700);
    for (const l of lines) {
      const body = makeLine(l.type);
      if (l.type === "cmd") {
        cursorTo(body.parentElement);
        await type(body, l.text);
        await wait(350);
      } else {
        body.textContent = l.text;
        cursorTo(null);
        await wait(l.type === "ok" ? 500 : 300);
      }
    }
    const idle = makeLine("cmd");
    cursorTo(idle.parentElement);
  }

  play();

  // Latest version badge — fetched client-side so it never goes
  // stale between website deploys (which don't happen on every dem
  // release).
  (async () => {
    const el = document.getElementById("version-text");
    if (!el) return;
    try {
      const res = await fetch("https://api.github.com/repos/ki-kneip/dem/releases/latest");
      if (!res.ok) return;
      const data = await res.json();
      if (typeof data.tag_name === "string" && data.tag_name) {
        el.textContent = data.tag_name;
      }
    } catch {
      // keep the "Latest release" fallback text
    }
  })();
</script>

<style>
  .hero {
    position: relative;
    padding-bottom: 40px;
    overflow: hidden;
  }

  /* background */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(148, 163, 184, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 30%, transparent 75%);
  }
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.32;
    animation: drift 14s ease-in-out infinite alternate;
  }
  .glow-a {
    width: 480px;
    height: 480px;
    background: #3ddc84;
    top: -220px;
    left: -120px;
  }
  .glow-b {
    width: 420px;
    height: 420px;
    background: #22d3ee;
    top: -160px;
    right: -100px;
    animation-delay: -7s;
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(60px, 40px) scale(1.12);
    }
  }

  /* nav */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    padding-bottom: 24px;
    position: relative;
    z-index: 2;
  }
  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .brand-mark {
    color: var(--accent);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .nav-links a {
    transition: color 0.2s ease;
  }
  .nav-links a:hover {
    color: var(--text);
  }
  .nav-gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
  }
  .nav-gh:hover {
    border-color: var(--border-strong);
  }
  @media (max-width: 720px) {
    .nav-links a:not(.nav-gh) {
      display: none;
    }
  }

  .version-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 12px;
    background: rgba(255, 255, 255, 0.02);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .version-badge:hover {
    color: var(--accent);
    border-color: var(--border-strong);
  }
  .version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6);
    animation: version-pulse 2.2s infinite;
  }
  @keyframes version-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.55);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(61, 220, 132, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0);
    }
  }

  /* hero layout */
  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 48px;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding-top: 40px;
    }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 16px;
    margin-bottom: 24px;
    background: rgba(255, 255, 255, 0.02);
  }
  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6);
    animation: pulse 2.2s infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.55);
    }
    70% {
      box-shadow: 0 0 0 9px rgba(61, 220, 132, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(61, 220, 132, 0);
    }
  }

  .hero-title {
    font-size: clamp(2.3rem, 5.4vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-bottom: 20px;
  }
  .grad {
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    color: var(--text-muted);
    font-size: 1.08rem;
    max-width: 480px;
    margin-bottom: 32px;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .hero-meta i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-faint);
  }

  /* terminal */
  .terminal-wrap {
    position: relative;
  }
  .terminal {
    background: rgba(13, 18, 28, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 70px -18px rgba(0, 0, 0, 0.65);
  }
  .terminal-shadow {
    position: absolute;
    inset: 20% -8% -6% -8%;
    background: var(--gradient);
    filter: blur(70px);
    opacity: 0.14;
    z-index: -1;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 13px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .dot-r {
    background: #ff5f57;
  }
  .dot-y {
    background: #febc2e;
  }
  .dot-g {
    background: #28c840;
  }
  .terminal-title {
    margin-left: 10px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
  }
  .terminal-body {
    padding: 20px 20px 24px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.9;
    min-height: 250px;
  }
  .terminal-body :global(.t-line) {
    white-space: pre-wrap;
  }
  .terminal-body :global(.t-prompt) {
    color: var(--accent-2);
  }
  .terminal-body :global(.t-check) {
    color: var(--accent);
  }
  .terminal-body :global(.t-ok),
  .terminal-body :global(.t-out) {
    color: var(--text-muted);
  }
  .terminal-body :global(.t-out) {
    color: var(--text);
  }
  .terminal-body :global(.t-cursor) {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    background: var(--accent);
    vertical-align: text-bottom;
    margin-left: 2px;
    animation: blink 1.05s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
