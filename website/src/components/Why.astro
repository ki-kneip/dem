---
const items = [
  {
    title: "One tool, not five",
    desc: "nvm, sdkman, pyenv, gvm… each with its own shell hacks and config files. dem is one binary, one config format and one mental model for every runtime.",
    icon: `<path d="M4 7h16M4 12h16M4 17h10"/>`,
  },
  {
    title: "First-class Windows",
    desc: "No shell integration required — anywhere. Shims are native hardlinks on your PATH, so it works the same in PowerShell, cmd, bash and CI.",
    icon: `<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/>`,
  },
  {
    title: "Per project or global",
    desc: "Drop a dem.yaml at your project root and every tool run inside it uses those versions. Commit it, and the whole team is on the same page.",
    icon: `<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>`,
  },
];
---

<section id="why">
  <div class="container">
    <p class="section-label reveal">Why dem</p>
    <h2 class="section-title reveal" style="--reveal-delay: 60ms">
      Stop collecting version managers
    </h2>
    <p class="section-desc reveal" style="--reveal-delay: 120ms">
      Every runtime ships its own manager with its own quirks. dem replaces
      them all with a single, predictable workflow.
    </p>

    <div class="why-grid">
      {
        items.map((item, i) => (
          <article class="card reveal" style={`--reveal-delay: ${i * 90}ms`}>
            <div class="why-icon">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={item.icon}
              />
            </div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 820px) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
  .why-icon {
    display: inline-flex;
    padding: 11px;
    border-radius: 11px;
    background: var(--accent-dim);
    color: var(--accent);
    margin-bottom: 18px;
  }
  .card h3 {
    font-size: 1.08rem;
    font-weight: 600;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .card p {
    color: var(--text-muted);
    font-size: 0.94rem;
  }
</style>
